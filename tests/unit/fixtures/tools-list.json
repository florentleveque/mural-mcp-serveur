  {
    "name": "create-mural",
    "title": "Create Mural",
    "description": "Create a new blank mural in a room (requires murals:write)",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "roomId": {
          "type": "number",
          "description": "The numeric identifier of the destination room"
        },
        "title": {
          "description": "Optional title of the new mural",
          "type": "string"
        },
        "backgroundColor": {
          "description": "Optional background color (hex, e.g. #FFFFFFFF)",
          "type": "string"
        },
        "width": {
          "description": "Optional canvas width in pixels",
          "type": "number"
        },
        "height": {
          "description": "Optional canvas height in pixels",
          "type": "number"
        },
        "infinite": {
          "description": "Optional. Whether the canvas is infinite",
          "type": "boolean"
        },
        "folderId": {
          "description": "Optional destination folder id within the room",
          "type": "string"
        }
      },
      "required": ["roomId"],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "update-mural",
    "title": "Update Mural",
    "description": "Update a mural's properties by id (title, status, dimensions, sharing permissions...). Provide at least one field (requires murals:write)",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "muralId": {
          "type": "string",
          "minLength": 1,
          "description": "The unique identifier of the mural to update"
        },
        "title": {
          "type": "string"
        },
        "backgroundColor": {
          "description": "Hex background color",
          "type": "string"
        },
        "favorite": {
          "type": "boolean"
        },
        "status": {
          "description": "Set to \"archived\" to archive the mural (non-destructive alternative to delete)",
          "type": "string",
          "enum": ["active", "archived"]
        },
        "width": {
          "description": "Canvas width (3000-60000)",
          "type": "number"
        },
        "height": {
          "description": "Canvas height (3000-60000)",
          "type": "number"
        },
        "infinite": {
          "type": "boolean"
        },
        "visitorsPermission": {
          "type": "string",
          "enum": ["read", "write", "none"]
        },
        "workspaceMembersPermission": {
          "type": "string",
          "enum": ["read", "write", "none"]
        },
        "folderId": {
          "type": "string"
        }
      },
      "required": ["muralId"],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "delete-mural",
    "title": "Delete Mural",
    "description": "Permanently delete a mural by its id (irreversible; requires murals:write). For a non-destructive alternative, use update-mural with status \"archived\"",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "muralId": {
          "type": "string",
          "minLength": 1,
          "description": "The unique identifier of the mural to delete"
        }
      },
      "required": ["muralId"],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "duplicate-mural",
