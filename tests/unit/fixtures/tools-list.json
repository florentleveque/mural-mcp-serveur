  {
    "name": "create-room",
    "title": "Create Room",
    "description": "Create a new room in a workspace",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "description": "The unique identifier of the workspace"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the new room"
        },
        "type": {
          "type": "string",
          "enum": ["open", "private"],
          "description": "Room visibility: \"open\" (discoverable by workspace members) or \"private\""
        },
        "description": {
          "description": "Optional description of the room",
          "type": "string"
        },
        "confidential": {
          "description": "Optional. Mark the room as confidential (defaults to false)",
          "type": "boolean"
        }
      },
      "required": ["workspaceId", "name", "type"],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "list-workspace-templates",
    "title": "List Workspace Templates",
    "description": "List a workspace's templates (default + custom), or search them by name. Returns all pages. Compact view keeps: id, name, description, type. Pass verbose=true for the full raw objects (thumbUrl, viewLink, createdBy, updatedOn, ...).",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "description": "The unique identifier of the workspace"
        },
        "searchQuery": {
          "description": "Optional. If provided, search templates by name instead of listing all",
          "type": "string"
        },
        "withoutDefault": {
          "default": false,
          "description": "If true, exclude Mural default templates and return only custom ones (optional, ignored when searchQuery is set)",
          "type": "boolean"
        },
        "verbose": {
          "default": false,
          "description": "If true, return the full raw objects instead of the compact view (optional, defaults to false)",
          "type": "boolean"
        }
      },
      "required": ["workspaceId"],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
