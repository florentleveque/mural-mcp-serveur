[
  {
    "name": "list-workspaces",
    "title": "List Workspaces",
    "description": "List all workspaces the authenticated user has access to. Compact view keeps: id, name. Pass verbose=true for the full raw objects (description, image, locked, suspended, createdOn, ...).",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "limit": {
          "description": "Maximum number of workspaces to return (optional)",
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "description": "Number of workspaces to skip for pagination (optional)",
          "type": "number",
          "minimum": 0
        },
        "verbose": {
          "default": false,
          "description": "If true, return the full raw objects instead of the compact view (optional, defaults to false)",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
