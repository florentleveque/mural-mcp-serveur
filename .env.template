# Variables for `pnpm dev:http` (a local run of the hosted server).
# On Vercel they are project environment variables: see docs/http-deployment.md.
# Copy this file to .env; never commit .env.

# The Mural OAuth app (https://app.mural.co, "Create and manage apps").
MURAL_CLIENT_ID=your_client_id_here
MURAL_CLIENT_SECRET=your_client_secret_here

# Seals tokens and records: generate with `openssl rand -base64 32`.
TOKEN_ENCRYPTION_KEY=

# Upstash Redis REST endpoint and token (the Upstash integration provides them).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: the public base URL, when clients reach the server elsewhere than
# http://localhost:3000.
# PUBLIC_URL=
