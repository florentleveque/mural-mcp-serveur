{
  "name": "@florentleveque/mural-mcp-serveur",
  "version": "1.3.1",
  "description": "Model Context Protocol server for Mural visual collaboration platform",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mural-mcp-serveur": "./build/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "lefthook install || true",
    "prepublishOnly": "pnpm build",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write ."
  },
  "keywords": [
    "mcp",
    "mural",
    "visual-collaboration",
    "model-context-protocol",
    "ai",
    "llm",
    "oauth"
  ],
  "author": "Florent Lévêque <florent.leveque@digital4better.com>",
  "license": "MIT",
  "homepage": "https://github.com/florentleveque/mural-mcp-serveur#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florentleveque/mural-mcp-serveur.git"
  },
  "bugs": {
    "url": "https://github.com/florentleveque/mural-mcp-serveur/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.1",
    "dotenv": "^17.2.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/node": "~24.19.0",
    "@vitest/coverage-v8": "^4.1.8",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "lefthook": "^2.1.15",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  }
}
