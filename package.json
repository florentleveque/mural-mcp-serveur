{
  "name": "@florentleveque/mural-mcp-serveur",
  "version": "2.0.0",
  "description": "Model Context Protocol server for Mural visual collaboration platform",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "dev:http": "pnpm build && node --env-file-if-exists=.env scripts/dev-http.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node scripts/smoke-http.mjs",
    "prepare": "lefthook install || true",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write .",
    "test:mutation": "stryker run",
    "test:mutation:canary": "node scripts/mutation-canary.mjs",
    "test:mutation:diff": "node scripts/mutation-scope.mjs diff",
    "test:mutation:summary": "node scripts/mutation-scope.mjs summary"
  },
  "keywords": [
    "mcp",
    "mural",
    "visual-collaboration",
    "model-context-protocol",
    "ai",
    "llm",
    "oauth"
  ],
  "author": "Florent Lévêque <florent.leveque@digital4better.com>",
  "license": "MIT",
  "homepage": "https://github.com/florentleveque/mural-mcp-serveur#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florentleveque/mural-mcp-serveur.git"
  },
  "bugs": {
    "url": "https://github.com/florentleveque/mural-mcp-serveur/issues"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "oidc-provider": "~9.12.2",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "~24.19.0",
    "@types/oidc-provider": "~9.12.1",
    "@vitest/coverage-v8": "^5.0.2",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "lefthook": "^2.1.15",
    "msw": "^2.15.0",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.2",
    "vitest": "^5.0.2"
  }
}
